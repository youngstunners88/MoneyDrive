  submitShortsJob: (req: ShortsRequest) -> (variant {
                                              err: text;
                                              ok: text;
                                            });
  submitZeroXWorkTask: (taskId: text, deliverable: text) ->
   (variant {
      err: text;
      ok: text;
    });
  sync0xWorkEarnings: () -> (variant {
                               err: text;
                               ok: ZeroXWorkEarnings;
                             });
  /// Admin only: sync 0xWork earnings AND update the X posting threshold tracker.
  /// Wraps sync0xWorkEarnings() and then calls updateMonthlyXEarnings() with the
  /// latest cumulative USDC converted to cents (1 USDC = 100 cents).
  syncEarningsAndXThreshold: () -> (variant {
                                      err: text;
                                      ok: text;
                                    });
  syncXPostMetrics: () -> (variant {
                             err: text;
                             ok: nat;
                           });
  tavilySearch: (searchQuery: text, searchContext: text) ->
   (variant {
      err: text;
      ok: text;
    });
  /// Admin only: test the stored Exa API key by running a company research query.
  /// Returns a summary string (company name + snippet) on success, or an error message.
  testExaCompanyResearch: (searchQuery: text) ->
   (variant {
      err: text;
      ok: text;
    });
  transform: (input: TransformationInput) -> (TransformationOutput) query;
  trigger0xWorkRegistration: () -> (variant {
                                      err: text;
                                      ok: text;
                                    });
  triggerBrowserbaseHunt: (driverPrincipal: principal) ->
   (variant {
      err: text;
      ok: text;
    });
  triggerLeadRefresh: () -> (variant {
                               err: text;
                               ok: text;
                             });
  triggerNdunaXPost: (postType: XPostType) ->
   (variant {
      err: text;
      ok: XPost;
    });
  triggerOpportunityHunt: (driverId: text) -> (variant {
                                                 err: text;
                                                 ok: text;
                                               });
  /// Admin only: trigger Orbis agent self-registration.
  /// Calls the Orbis discovery → register → subscribe flow and stores the returned
  /// sk_... API key into orbisApiKeyStore automatically on success.
  triggerOrbisRegistration: (email: text, password: text, username: text) ->
   (variant {
      err: text;
      ok: text;
    });
  triggerReferralBonus: (newDriverId: text) -> (opt text);
  triggerTaskDiscovery: () -> (variant {
                                 err: text;
                                 ok: nat;
                               });
  triggerVideoProcessing: (uploadId: text) -> (variant {
                                                 err: text;
                                                 ok: text;
                                               });
  triggerWeeklyBriefings: () -> (record {
                                   failed: nat;
                                   sent: nat;
                                 });
  updateDriverMemory: (notes: text, userProfile: text) -> ();
  updateDriverRating: (rating: float64) -> (variant {
                                              err: text;
                                              ok;
                                            });
  updateLeadStatus: (leadId: text, status: LeadStatus) ->
   (variant {
      err: text;
      ok;
    });
  updateMarkdownContent: (storageRef: text, content: opt text, status:
   MarkdownStatus) -> (variant {
                         err: text;
                         ok;
                       });
  updateMonthlyXEarnings: (earningsCents: nat) -> (variant {
                                                     err: text;
                                                     ok;
                                                   });
  updateNdunaSystemPrompt: (delta: text) -> (variant {
                                               err: text;
                                               ok;
                                             });
  updatePitch: (id: text, updated: CompanyPitch) -> (bool);
  updatePitchStatus: (id: text, status: PitchStatus) -> (bool);
  updateShortsJobStatus: (jobId: text, status: ShortsStatus, outputUrl:
   opt text, errorMsg: opt text) -> (variant {
                                       err: text;
                                       ok;
                                     });
  uploadDocument: (storageRef: text, docType: DocumentType, fileName: 
   text, notes: text) -> (variant {
                            err: text;
                            ok: text;
                          });
  upsertCompetitiveProfile: (city: text, surgeAccuracy: float64, dealsClosed:
   nat, avgDealValue: nat) -> ();
}
