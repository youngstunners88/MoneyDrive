   errorCount: nat;
   ndunaQueryCount: nat;
   topActions: vec record {
                     text;
                     nat;
                   };
   totalEvents: nat;
 };
type AnalyticsEvent = 
 record {
   action: text;
   category: text;
   driverId: text;
   durationMs: opt int;
   errorMessage: opt text;
   id: text;
   metadata: text;
   success: bool;
   tier: opt text;
   timestamp: int;
 };
type AgentMailConfig = 
 record {
   apiKey: text;
   leadFollowupEmailEnabled: bool;
   ndunaInboxId: opt text;
   onboardingEmailEnabled: bool;
   weeklyBriefingEmailEnabled: bool;
 };
type AbTestResult = 
 record {
   aConversionRate: float64;
   bConversionRate: float64;
   campaignAId: text;
   campaignBId: text;
   decidedAt: opt int;
   winnerCampaignId: opt text;
 };
